# MBTA V3 API key (https://api-v3.mbta.com/register). Server-only, never exposed to the browser.
MBTA_API_KEY=

# Hosted Postgres (Tiger Data, Neon or Supabase). Empty = in-memory fallback (single instance only).
DATABASE_URL=

# Gemini (optional photo check, T17)
GEMINI_API_KEY=

# Demo / mock switches
# 1 = UI data hooks return src/contracts/fixtures.ts instead of fetching
NEXT_PUBLIC_USE_MOCKS=0
# Public base URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Shared secret for admin/demo endpoints (simulate delay, sim controls). Empty = open (dev only).
ADMIN_TOKEN=
